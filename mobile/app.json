{
  "expo": {
    "name": "SAM",
    "slug": "sam-mobile",
    "version": "1.0.0",
    "scheme": "sam",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hectic.sam.mobile",
      "appleTeamId": "CC9Q9BH5NT",
      "buildNumber": "110",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.hectic.sam.mobile"
        ]
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "SAM uses the camera to attach a photo or scan a pairing QR. A photo you attach goes to the AI model you pick — on-device, your Mac, or a cloud model if you choose one.",
        "NSPhotoLibraryUsageDescription": "SAM reads a photo only when you pick one to attach. It goes to the AI model you pick — on-device, your Mac, or a cloud provider if you use one.",
        "NSLocalNetworkUsageDescription": "SAM talks to SAM on your own computer when you pair, usually on your home network. Pairing is optional. Standalone chat uses the AI model you pick and is not limited to your Mac.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.hectic.sam.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FBEDE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "cameraPermission": "SAM uses the camera to attach a photo to a message, or to scan the QR code that pairs this phone with your Mac/PC — nothing leaves your own SAM.",
          "photosPermission": "SAM reads a photo only when you pick one to attach — it goes to your own SAM on your machine, nowhere else."
        }
      ],
      "expo-notifications",
      "./plugins/with-space-safe-pods",
      "./plugins/with-ios-widget",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7164bfb8-8184-427c-a6da-a901fa79a5ca",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "SAMWidget",
                  "bundleIdentifier": "com.hectic.sam.mobile.widget"
                }
              ]
            }
          }
        }
      }
    },
    "owner": "piing"
  }
}
