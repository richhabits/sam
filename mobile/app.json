{
  "expo": {
    "name": "SAM",
    "slug": "sam-mobile",
    "version": "1.0.0",
    "scheme": "sam",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hectic.sam.mobile",
      "appleTeamId": "CC9Q9BH5NT",
      "buildNumber": "10",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "SAM uses the camera to attach a photo to a message, or to scan the QR code that pairs this phone with your Mac/PC — nothing leaves your own SAM.",
        "NSPhotoLibraryUsageDescription": "SAM reads a photo only when you pick one to attach — it goes to your own SAM on your machine, nowhere else.",
        "NSLocalNetworkUsageDescription": "SAM talks to the SAM running on your own computer, usually over your home network. Nothing is sent anywhere else.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FBEDE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "cameraPermission": "SAM uses the camera when you attach a photo to a message — the image is sent to your own SAM on your machine, nowhere else.",
          "photosPermission": "SAM reads a photo only when you pick one to attach — it goes to your own SAM on your machine, nowhere else."
        }
      ],
      "expo-notifications",
      "./plugins/with-space-safe-pods",
      "./plugins/with-ios-widget"
    ],
    "extra": {
      "eas": {
        "projectId": "7164bfb8-8184-427c-a6da-a901fa79a5ca",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "SAMWidget",
                  "bundleIdentifier": "com.hectic.sam.mobile.widget"
                }
              ]
            }
          }
        }
      }
    },
    "owner": "piing"
  }
}