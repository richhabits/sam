{
  "name": "sam",
  "version": "3.5.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "S.A.M. — Smart Artificial Mind. Your private, free, local-first AI assistant that actually does things.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "dev": "concurrently -k -n \"SERVER,HUD\" -c \"#E8673A,#C4A882\" \"npm:dev:server\" \"npm:dev:hud\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:hud": "vite",
    "dev:daemon": "tsx watch scripts/local-automation-daemon.ts",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs && esbuild server/yard/worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/yard-worker.mjs",
    "build:mac": "node scripts/preflight-build.mjs && npm run build && electron-builder --mac",
    "build:win": "node scripts/preflight-build.mjs && npm run build && electron-builder --win",
    "build:linux": "node scripts/preflight-build.mjs && npm run build && electron-builder --linux",
    "build:all": "node scripts/preflight-build.mjs && npm run build && electron-builder -mwl",
    "start": "npm run build && node dist/server.mjs",
    "start:fast": "node dist/server.mjs",
    "start:daemon": "tsx scripts/local-automation-daemon.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "check:orphans": "tsx scripts/check-orphans.ts",
    "selftest": "tsx server/selftest.ts",
    "skill:new": "node scripts/new-skill.mjs",
    "ship": "node scripts/ship.mjs",
    "landing": "node scripts/gen-landing.mjs",
    "og": "node scripts/gen-og.mjs",
    "build:mac:signed": "node scripts/build-signed.mjs",
    "release:app": "node scripts/build-signed.mjs --upload",
    "bench": "tsx scripts/bench.ts",
    "routes": "tsx --env-file-if-exists=.env scripts/routes.ts",
    "rollback": "tsx scripts/rollback.ts",
    "stats": "tsx scripts/generate-stats.ts",
    "platforms": "tsx scripts/platform-matrix.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "create-tool": "node scripts/create-tool.mjs",
    "create-pack": "node scripts/create-pack.mjs",
    "validate-packs": "tsx scripts/validate-packs.ts",
    "electron:sqlite": "node scripts/electron-sqlite.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "bonjour-service": "^1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "mammoth": "^1.12.1",
    "nodemailer": "^9.0.5",
    "pdf-parse": "2.4.5",
    "playwright-core": "^1.62.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^8.10.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@electron/notarize": "^3.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.hectic.sam",
    "productName": "SAM",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "**/*",
      "!vault/**",
      "!.env",
      "!.env.*",
      "!**/*.test.*",
      "!dist-app/**",
      "!.git/**",
      "!src/**",
      "!server/**",
      "!scripts/**",
      "!e2e/**",
      "!bench/**",
      "!docs/**",
      "!.github/**",
      "!community/**",
      "!gateway/**",
      "!mobile/**",
      "!graphify-out/**"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/playwright-core/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "SAM uses the camera when you ask it to look, scan, or recognise people — all processed on your machine.",
        "NSMicrophoneUsageDescription": "SAM uses the microphone for voice chat and dictation — processed on your machine.",
        "NSLocalNetworkUsageDescription": "Only if you switch on P2P (SAM_P2P=1): SAM finds the other machines you run it on, over your own network. Off by default, and it never leaves your network."
      },
      "icon": "build/icon-mac.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "HECTIC",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "richhabits",
        "repo": "sam",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false,
    "afterSign": "scripts/notarize.mjs",
    "afterAllArtifactBuild": "scripts/staple-dmg.mjs"
  }
}
